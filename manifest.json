{
  "manifest_version": 3,
  "name": "Productivity",
  "version": "1.1.0",
  "description": "Browse page outlines, switch recent tabs, force dark mode on websites, mark tabs, and customize the new tab page.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "contextMenus",
    "favicon",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "topSites"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Page outline",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/module-settings.js",
        "content/tab-marker.js",
        "content/dark-mode.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://arsiv.mackolik.com/*"
      ],
      "js": [
        "content/mackolik-dark-theme-rules.js",
        "content/mackolik-dark-theme.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://arsiv.mackolik.com/Canli-Sonuclar*"
      ],
      "js": [
        "shared/mackolik-settings.js",
        "content/mackolik-priority-rows.js",
        "content/mackolik-featured-video.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://huggingface.co/*"
      ],
      "js": [
        "content/scrollbar-width.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/youtube-section-toggle.js",
        "content/youtube-shorts-blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*/*"],
      "js": ["content/github-creation-date.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://calendar.google.com/calendar/*"],
      "js": ["content/calendar-highlight-today.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["shared/x-keywords.js", "content/x-keyword-filter.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-last-tab": {
      "suggested_key": {
        "mac": "Command+Shift+D",
        "default": "Ctrl+Shift+Tab"
      },
      "description": "Toggle between the two most recently visited tabs"
    }
  }
}
