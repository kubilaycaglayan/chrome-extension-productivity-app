{
  "manifest_version": 3,
  "name": "Productivity",
  "version": "1.1.0",
  "description": "Browse page outlines, block ads, read CSVs as tables, switch recent tabs, force dark mode, mark tabs, and customize the new tab page.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "contextMenus",
    "favicon",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "topSites",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Page outline",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/cookie-accepter-settings.js",
        "content/cookie-accepter.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/module-settings.js",
        "content/tab-marker.js",
        "content/dark-mode.js",
        "shared/csv-table.js",
        "content/csv-viewer.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://arsiv.mackolik.com/*"
      ],
      "js": [
        "content/mackolik-dark-theme-rules.js",
        "content/mackolik-dark-theme.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://arsiv.mackolik.com/Canli-Sonuclar*"
      ],
      "js": [
        "shared/mackolik-settings.js",
        "content/mackolik-priority-rows.js",
        "content/mackolik-featured-video.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://huggingface.co/*"
      ],
      "js": [
        "content/scrollbar-width.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/youtube-section-toggle.js",
        "content/youtube-shorts-blocker.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://github.com/*/*"
      ],
      "js": [
        "content/github-creation-date.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://calendar.google.com/calendar/*"
      ],
      "js": [
        "content/calendar-highlight-today.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "shared/x-keywords.js",
        "content/x-keyword-filter.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-last-tab": {
      "suggested_key": {
        "mac": "Command+Shift+D",
        "default": "Ctrl+Shift+Tab"
      },
      "description": "Toggle between the two most recently visited tabs"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist_ads",
        "enabled": true,
        "path": "rules/easylist-ads.json"
      },
      {
        "id": "easylist_ads_extra",
        "enabled": false,
        "path": "rules/easylist-ads-extra.json"
      },
      {
        "id": "easylist_ads_extra_2",
        "enabled": false,
        "path": "rules/easylist-ads-extra-2.json"
      },
      {
        "id": "easylist_ads_extra_3",
        "enabled": false,
        "path": "rules/easylist-ads-extra-3.json"
      },
      {
        "id": "easylist_ads_extra_4",
        "enabled": false,
        "path": "rules/easylist-ads-extra-4.json"
      },
      {
        "id": "easylist_ads_extra_5",
        "enabled": false,
        "path": "rules/easylist-ads-extra-5.json"
      },
      {
        "id": "easylist_ads_extra_6",
        "enabled": false,
        "path": "rules/easylist-ads-extra-6.json"
      }
    ]
  }
}
